import React, { useState, useEffect } from 'react';
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  ScrollView,
  StyleSheet,
  Alert,
  Platform,
} from 'react-native';
import { NavigationContainer } from '@react-navigation/native';
import { createBottomTabNavigator } from '@react-navigation/bottom-tabs';
import * as Notifications from 'expo-notifications';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { Ionicons } from '@expo/vector-icons';

Notifications.setNotificationHandler({
  handleNotification: async () => ({
    shouldShowAlert: true,
    shouldShowBanner: true,
    shouldShowList: true,
    shouldPlaySound: true,
    shouldSetBadge: false,
  }),
});

type Lembrete = {
  id: string;
  titulo: string;
  descricao: string;
  horario: string;
  recorrencia: 'Unica' | 'Diaria';
  status: 'Agendado' | 'Concluido' | 'Adiado' | 'Cancelado';
  idNotificacao?: string;
};

const CHAVE_ARMAZENAMENTO = '@meus_lembretes';

const Abas = createBottomTabNavigator();

export default function App() {
  const [lembretes, setLembretes] = useState<Lembrete[]>([]);


  useEffect(() => {
    // Pede permissao para notificacoes
    async function inicializarNotificacoes() {
      const { status } = await Notifications.requestPermissionsAsync();
      if (status !== 'granted') {
        Alert.alert('Aviso', 'A permissao para notificacoes nao foi concedida.');
      }


      await Notifications.setNotificationCategoryAsync('CATEGORIA_LEMBRETE', [
        {
          identifier: 'ACAO_CONCLUIR',
          buttonTitle: 'Concluir',
        },
        {
          identifier: 'ACAO_ADIAR',
          buttonTitle: 'Adiar 10 min',
        },
      ]);

      if (Platform.OS === 'android') {
        await Notifications.setNotificationChannelAsync('padrao', {
          name: 'Lembretes',
          importance: Notifications.AndroidImportance.MAX,
          vibrationPattern: [0, 250, 250, 250],
        });
      }
    }

    inicializarNotificacoes();
    carregarLembretes();
  }, []);


  useEffect(() => {
    const inscricao = Notifications.addNotificationResponseReceivedListener((resposta) => {
      const idAcao = resposta.actionIdentifier;
      const idLembrete = resposta.notification.request.content.data?.idLembrete as string | undefined;

      if (!idLembrete) return;

      if (idAcao === 'ACAO_CONCLUIR') {
        concluirLembrete(idLembrete);
      } else if (idAcao === 'ACAO_ADIAR') {
        adiarLembrete(idLembrete);
      }
    });


    return () => {
      inscricao.remove();
    };
  }, [lembretes]);


  async function carregarLembretes() {
    try {
      const dadosSalvos = await AsyncStorage.getItem(CHAVE_ARMAZENAMENTO);
      if (dadosSalvos) {
        setLembretes(JSON.parse(dadosSalvos));
      } else {

        const dadosIniciais: Lembrete[] = [
          {
            id: '1',
            titulo: 'Beber agua',
            descricao: 'Um copo de 300 ml',
            horario: '08:00',
            recorrencia: 'Diaria',
            status: 'Agendado',
          },
          {
            id: '2',
            titulo: 'Alongar',
            descricao: 'Pausa para alongamento',
            horario: '15:30',
            recorrencia: 'Diaria',
            status: 'Agendado',
          },
          {
            id: '3',
            titulo: 'Estudar',
            descricao: 'Revisar materia do app',
            horario: '20:00',
            recorrencia: 'Unica',
            status: 'Agendado',
          },
        ];
        setLembretes(dadosIniciais);
        await AsyncStorage.setItem(CHAVE_ARMAZENAMENTO, JSON.stringify(dadosIniciais));
      }
    } catch (erro) {
      console.log('Erro ao carregar dados:', erro);
    }
  }


  async function salvarLembretes(novaLista: Lembrete[]) {
    try {
      setLembretes(novaLista);
      await AsyncStorage.setItem(CHAVE_ARMAZENAMENTO, JSON.stringify(novaLista));
    } catch (erro) {
      console.log('Erro ao salvar dados:', erro);
    }
  }


  async function agendarLembrete(
    titulo: string,
    descricao: string,
    horario: string,
    recorrencia: 'Unica' | 'Diaria'
  ) {
    let segundos = 5;


    if (!isNaN(Number(horario)) && Number(horario) > 0) {
      segundos = Number(horario);
    } else if (horario.includes(':')) {
      const partes = horario.split(':');
      const hora = parseInt(partes[0], 10) || 0;
      const minuto = parseInt(partes[1], 10) || 0;

      const agora = new Date();
      const horarioAlvo = new Date();
      horarioAlvo.setHours(hora, minuto, 0, 0);

      const diferenca = Math.floor((horarioAlvo.getTime() - agora.getTime()) / 1000);

      segundos = diferenca > 0 ? diferenca : 5;
    }

    const novoId = Date.now().toString();


    let trigger: Notifications.NotificationTriggerInput;
    if (recorrencia === 'Diaria' && horario.includes(':')) {
      const partes = horario.split(':');
      trigger = {
        type: Notifications.SchedulableTriggerInputTypes.DAILY,
        hour: parseInt(partes[0], 10),
        minute: parseInt(partes[1], 10),
      };
    } else {
      trigger = {
        type: Notifications.SchedulableTriggerInputTypes.TIME_INTERVAL,
        seconds: segundos,
      };
    }

    let idNotificacao: string | undefined;
    try {
      idNotificacao = await Notifications.scheduleNotificationAsync({
        content: {
          title: titulo,
          body: descricao || 'Lembrete do aplicativo',
          categoryIdentifier: 'CATEGORIA_LEMBRETE',
          data: { idLembrete: novoId },
        },
        trigger,
      });
    } catch (erro) {
      console.log('Erro ao agendar notificacao:', erro);
    }

    const novoLembrete: Lembrete = {
      id: novoId,
      titulo,
      descricao,
      horario,
      recorrencia,
      status: 'Agendado',
      idNotificacao,
    };

    const listaAtualizada = [novoLembrete, ...lembretes];
    await salvarLembretes(listaAtualizada);
  }


  async function concluirLembrete(id: string) {
    const lembrete = lembretes.find((l) => l.id === id);
    if (lembrete?.idNotificacao) {
      await Notifications.cancelScheduledNotificationAsync(lembrete.idNotificacao);
    }

    const listaAtualizada = lembretes.map((l) =>
      l.id === id ? { ...l, status: 'Concluido' as const } : l
    );
    await salvarLembretes(listaAtualizada);
    Alert.alert('Lembrete Concluido', 'O lembrete foi marcado como concluido.');
  }


  async function adiarLembrete(id: string) {
    const lembrete = lembretes.find((l) => l.id === id);
    if (!lembrete) return;

    if (lembrete.idNotificacao) {
      await Notifications.cancelScheduledNotificationAsync(lembrete.idNotificacao);
    }


    let novoIdNotificacao: string | undefined;
    try {
      novoIdNotificacao = await Notifications.scheduleNotificationAsync({
        content: {
          title: `Adiado: ${lembrete.titulo}`,
          body: `Lembrete adiado em 10 minutos: ${lembrete.descricao}`,
          categoryIdentifier: 'CATEGORIA_LEMBRETE',
          data: { idLembrete: id },
        },
        trigger: {
          type: Notifications.SchedulableTriggerInputTypes.TIME_INTERVAL,
          seconds: 10 * 60,
        },
      });
    } catch (erro) {
      console.log('Erro ao adiar notificacao:', erro);
    }

    const listaAtualizada = lembretes.map((l) =>
      l.id === id ? { ...l, status: 'Adiado' as const, idNotificacao: novoIdNotificacao } : l
    );
    await salvarLembretes(listaAtualizada);
    Alert.alert('Lembrete Adiado', 'Lembrete adiado por 10 minutos.');
  }


  async function cancelarLembrete(id: string) {
    const lembrete = lembretes.find((l) => l.id === id);
    if (lembrete?.idNotificacao) {
      await Notifications.cancelScheduledNotificationAsync(lembrete.idNotificacao);
    }

    const listaAtualizada = lembretes.map((l) =>
      l.id === id ? { ...l, status: 'Cancelado' as const, idNotificacao: undefined } : l
    );
    await salvarLembretes(listaAtualizada);
    Alert.alert('Cancelado', 'A notificacao deste lembrete foi cancelada.');
  }


  async function cancelarTodasNotificacoes() {
    await Notifications.cancelAllScheduledNotificationsAsync();
    const listaAtualizada = lembretes.map((l) => ({
      ...l,
      status: 'Cancelado' as const,
      idNotificacao: undefined,
    }));
    await salvarLembretes(listaAtualizada);
    Alert.alert('Todas Canceladas', 'Todas as notificacoes agendadas foram canceladas.');
  }


  function TelaCadastro({ navigation }: any) {
    const [titulo, setTitulo] = useState('');
    const [descricao, setDescricao] = useState('');
    const [horario, setHorario] = useState('08:00');
    const [recorrencia, setRecorrencia] = useState<'Unica' | 'Diaria'>('Diaria');

    async function salvar() {
      if (!titulo.trim()) {
        Alert.alert('Aviso', 'Informe o titulo do lembrete.');
        return;
      }

      await agendarLembrete(titulo, descricao, horario, recorrencia);
      Alert.alert('Sucesso', 'Lembrete agendado com sucesso!');
      setTitulo('');
      setDescricao('');
      navigation.navigate('Agendados');
    }

    return (
      <ScrollView style={estilos.tela} contentContainerStyle={estilos.conteudo}>
        <Text style={estilos.tituloPrincipal}>Novo lembrete</Text>

        <View style={estilos.formulario}>
          <Text style={estilos.rotulo}>Titulo</Text>
          <TextInput
            style={estilos.campoTexto}
            placeholder="Ex: Beber agua"
            value={titulo}
            onChangeText={setTitulo}
          />

          <Text style={estilos.rotulo}>Descricao</Text>
          <TextInput
            style={[estilos.campoTexto, estilos.campoDescricao]}
            placeholder="Ex: Um copo de 300 ml"
            value={descricao}
            onChangeText={setDescricao}
            multiline
          />

          <Text style={estilos.rotulo}>Repeticao</Text>
          <View style={estilos.linhaBotoes}>
            <TouchableOpacity
              style={[
                estilos.botaoOpcao,
                recorrencia === 'Unica' && estilos.botaoOpcaoAtivo,
              ]}
              onPress={() => setRecorrencia('Unica')}
            >
              <Text
                style={[
                  estilos.textoBotaoOpcao,
                  recorrencia === 'Unica' && estilos.textoBotaoOpcaoAtivo,
                ]}
              >
                Unica
              </Text>
            </TouchableOpacity>

            <TouchableOpacity
              style={[
                estilos.botaoOpcao,
                recorrencia === 'Diaria' && estilos.botaoOpcaoAtivo,
              ]}
              onPress={() => setRecorrencia('Diaria')}
            >
              <Text
                style={[
                  estilos.textoBotaoOpcao,
                  recorrencia === 'Diaria' && estilos.textoBotaoOpcaoAtivo,
                ]}
              >
                Diaria
              </Text>
            </TouchableOpacity>
          </View>

          <Text style={estilos.rotulo}>Horario</Text>
          <TextInput
            style={estilos.campoTexto}
            placeholder="08:00"
            value={horario}
            onChangeText={setHorario}
          />
          <Text style={estilos.dica}>Dica: digite 5 para testar em 5 segundos</Text>

          <TouchableOpacity style={estilos.botaoPrincipal} onPress={salvar}>
            <Text style={estilos.textoBotaoPrincipal}>Agendar lembrete</Text>
          </TouchableOpacity>
        </View>
      </ScrollView>
    );
  }


  function TelaAgendados() {
    return (
      <ScrollView style={estilos.tela} contentContainerStyle={estilos.conteudo}>
        <Text style={estilos.tituloPrincipal}>Agendados</Text>

        {lembretes.length === 0 ? (
          <Text style={estilos.textoVazio}>Nenhum lembrete cadastrado.</Text>
        ) : (
          lembretes.map((item) => (
            <View key={item.id} style={estilos.cartao}>
              <View style={estilos.cabecalhoCartao}>
                <View style={{ flex: 1 }}>
                  <Text style={estilos.tituloCartao}>{item.titulo}</Text>
                  <Text style={estilos.subtituloCartao}>
                    {item.recorrencia === 'Diaria' ? 'Todo dia' : 'Unica'}, {item.horario}
                  </Text>
                  {item.descricao ? (
                    <Text style={estilos.descricaoCartao}>{item.descricao}</Text>
                  ) : null}
                  <Text style={estilos.statusCartao}>Status: {item.status}</Text>
                </View>
              </View>

              {/* Botoes de Acao do Lembrete */}
              <View style={estilos.linhaAcoes}>
                {item.status !== 'Concluido' && (
                  <TouchableOpacity
                    style={estilos.botaoAcao}
                    onPress={() => concluirLembrete(item.id)}
                  >
                    <Text style={estilos.textoBotaoAcao}>Concluir</Text>
                  </TouchableOpacity>
                )}

                {item.status !== 'Concluido' && (
                  <TouchableOpacity
                    style={estilos.botaoAcao}
                    onPress={() => adiarLembrete(item.id)}
                  >
                    <Text style={estilos.textoBotaoAcao}>Adiar 10 min</Text>
                  </TouchableOpacity>
                )}

                {item.status === 'Agendado' && (
                  <TouchableOpacity
                    style={[estilos.botaoAcao, estilos.botaoCancelarItem]}
                    onPress={() => cancelarLembrete(item.id)}
                  >
                    <Text style={estilos.textoCancelarItem}>Cancelar</Text>
                  </TouchableOpacity>
                )}
              </View>
            </View>
          ))
        )}


        {lembretes.length > 0 && (
          <TouchableOpacity
            style={estilos.botaoCancelarTodos}
            onPress={cancelarTodasNotificacoes}
          >
            <Text style={estilos.textoCancelarTodos}>Cancelar todos</Text>
          </TouchableOpacity>
        )}
      </ScrollView>
    );
  }

  return (
    <NavigationContainer>
      <Abas.Navigator
        screenOptions={({ route }) => ({
          tabBarActiveTintColor: '#000000',
          tabBarInactiveTintColor: '#888888',
          tabBarLabelStyle: { fontSize: 13, fontWeight: 'bold' },
          tabBarStyle: { height: 60, paddingBottom: 6 },
          tabBarIcon: ({ color, size }) => {
            let nomeIcone: keyof typeof Ionicons.glyphMap = 'add-circle-outline';
            if (route.name === 'Agendados') {
              nomeIcone = 'list-outline';
            }
            return <Ionicons name={nomeIcone} size={size} color={color} />;
          },
        })}
      >
        <Abas.Screen
          name="Novo Lembrete"
          component={TelaCadastro}
          options={{ title: 'Novo lembrete' }}
        />
        <Abas.Screen
          name="Agendados"
          component={TelaAgendados}
          options={{ title: 'Agendados' }}
        />
      </Abas.Navigator>
    </NavigationContainer>
  );
}


